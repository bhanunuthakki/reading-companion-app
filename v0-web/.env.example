# For local dev only — Vercel reads env vars from the project dashboard in production.
# Copy this file to `.env.local` (preferred for vercel dev) or `.env` and fill in.

# Get a key at https://aistudio.google.com/apikey (free tier covers Flash usage generously).
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-2.5-flash (GA).
# Switch to gemini-3.5-flash once it's reachable via the API (announced at I/O 2026 — may not be in the SDK yet).
GEMINI_MODEL=gemini-2.5-flash
