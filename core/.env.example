# Copy to .env and fill in. The core RUNS WITHOUT A KEY using the mock voice provider
# and stubbed enrichment — keys only unlock the real model/search paths.

# Gemini (OCR + research + Gemini Live voice). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Heavy-lift text model (OCR, research synthesis). I/O 2026 default: gemini-3.5-flash when reachable.
GEMINI_MODEL=gemini-2.5-flash
# Streaming realtime voice model for Gemini Live.
GEMINI_LIVE_MODEL=gemini-2.5-flash-live

# Which VoiceSession implementation to use: mock | gemini | openai
VOICE_PROVIDER=mock

# Optional: OpenAI Realtime fallback (documented second implementation).
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# Where durable session documents are written (satisfies days-later + across-devices resume).
SESSION_DIR=.sessions

# Thought-partner document stores (one JSON file per Thread / ResearchJob / Capture).
THREAD_DIR=.threads
JOB_DIR=.jobs
CAPTURE_DIR=.captures

# Artificial delay (ms) for the offline mock research digest so background jobs
# feel like background work in live demos. Tests always use 0.
MOCK_DIGEST_DELAY_MS=2500

# Whether the connected glasses have a display. false = audio-only devices, so
# job-completion delivery defaults to earcon instead of badge (etiquette rule 3).
DEVICE_HAS_DISPLAY=true

PORT=4000
